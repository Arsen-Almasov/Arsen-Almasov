        "\n",
        "stop_words = {\n",
        "    \"и\", \"в\", \"во\", \"на\", \"по\", \"за\", \"к\", \"ко\", \"с\", \"со\",\n",
        "    \"у\", \"о\", \"об\", \"от\", \"до\", \"для\", \"из\", \"при\", \"про\",\n",
        "    \"а\", \"но\", \"или\", \"что\", \"это\", \"как\", \"так\", \"же\",\n",
        "    \"бы\", \"ли\", \"мне\", \"мой\", \"моя\", \"мое\", \"мои\",\n",
        "    \"мы\", \"вы\", \"они\", \"он\", \"она\", \"оно\", \"я\",\n",
        "    \"все\", \"всё\", \"был\", \"была\", \"были\", \"быть\"\n",
        "}\n",
        "\n",
        "def clean_text(text):\n",
        "    text = str(text).lower()\n",
        "    text = re.sub(r\"\\d+\", \" \", text)\n",
        "    text = re.sub(r\"[^\\w\\s]\", \" \", text)\n",
        "    text = re.sub(r\"_+\", \" \", text)\n",
        "    words = text.split()\n",
        "    words = [word for word in words if word not in stop_words]\n",
        "    return \" \".join(words)\n",
        "\n",
        "df[\"clean_text\"] = df[\"text\"].apply(clean_text)\n",
